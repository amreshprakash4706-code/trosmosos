# Trosmos OS Server Configuration
# Copy to .env and adjust values for your environment.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Required in production — generate a long random string
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Optional AI (Gemini). Without this, AI endpoints return 503 gracefully.
GEMINI_API_KEY=
# AI_MODEL=gemini-2.0-flash

# Storage limits (bytes)
# MAX_STORAGE_BYTES=52428800
# MAX_FILE_SIZE_BYTES=5242880
# MAX_FILES_PER_USER=2000

# Database path (defaults to server/data/trosmos.db)
# DATABASE_PATH=

# CORS origins (comma-separated)
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
